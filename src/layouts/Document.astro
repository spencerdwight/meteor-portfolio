---
import { ClientRouter } from 'astro:transitions';

import '@fontsource/inter';

import Meteors from '~/components/Meteors.astro';

import '~/styles/global.css';
---

<!doctype html>
<html
	class="scroll-smooth antialiased selection:bg-primary-500 selection:text-white"
	lang="en"
>
	<head>
		<slot name="head" />
		<ClientRouter />
	</head>

	<body class="relative isolate min-h-screen overflow-x-hidden bg-white font-sans text-gray-800 dark:bg-gray-950 dark:text-gray-100">
		<Meteors number={24} />

		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>