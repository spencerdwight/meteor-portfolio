---
import { getCollection } from 'astro:content';

import FeaturedRelease from '~/components/FeaturedRelease.astro';
import Footer from '~/components/Footer.astro';
import Head from '~/components/Head.astro';
import Hero from '~/components/Hero.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import Catalog from '~/components/Widgets/Catalog.astro';
import List from '~/components/Widgets/List.astro';
import Timeline from '~/components/Widgets/Timeline.astro';
import { HOME_WIDGETS } from '~/constants';
import Document from '~/layouts/Document.astro';
import {
	filterPosts,
	mapPostToListItem,
	sortPostsByPublishedAt,
} from '~/utils/content';

const [posts, events, building] = await Promise.all([
	getCollection('posts').then((posts) =>
		posts
			.filter(filterPosts({ archived: false }))
			.sort(sortPostsByPublishedAt)
			.map(mapPostToListItem),
	),
	getCollection('events').then((events) =>
		events
			.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
			.map(({ data }) => data),
	),
	getCollection('building').then((building) =>
		building
			.sort(
				(a, b) =>
					b.data.publishedAt.valueOf() -
					a.data.publishedAt.valueOf(),
			)
			.map(({ data }) => ({
				title: data.title,
				icon: data.icon,
				publishedAt: data.publishedAt,
				...(data.url !== undefined ? { href: data.url } : {}),
			})),
	),
]);
---

<Head />

<Document>
	<main class="mx-auto flex h-full max-w-4xl flex-col space-y-10 px-4 pb-8 pt-12 sm:px-6 lg:px-8">
		<div class="relative z-10 space-y-6">
			<SocialLinks />
			<Hero />
		</div>

		<FeaturedRelease />

		<div class="z-10 grid grid-cols-1 gap-8 md:grid-cols-10">
			{HOME_WIDGETS.catalog ? (
				<Catalog class="min-h-48 md:col-span-6 md:min-h-80" />
			) : null}

			<Timeline
				class="min-h-48 max-h-80 scrollbar-hidden md:col-span-4 md:min-h-80"
				id="shows"
				events={events}
				title="Shows"
			/>

			<List
				class="min-h-48 max-h-80 md:col-span-6 md:min-h-80"
				id="posts"
				items={posts}
				title="Posts"
				href="/posts"
			/>

			{HOME_WIDGETS.building ? (
				<List
					class="min-h-48 max-h-80 md:col-span-6 md:min-h-80"
					id="building"
					items={building}
					title="Building"
				/>
			) : null}
		</div>
	</main>

	<Footer class="max-w-4xl">
		<div class="mt-8 md:order-1 md:mt-0">
			<p class="text-center text-xs font-medium leading-5 text-gray-400">
				&copy; {new Date().getFullYear()}
			</p>
		</div>
	</Footer>
</Document>