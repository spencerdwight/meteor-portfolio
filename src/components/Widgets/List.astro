---
import { formatLongDate, formatShortDate } from '~/utils/date';
import * as Icons from 'lucide-astro';
import { Newspaper } from 'lucide-astro';

import { cn } from '~/utils/cn';

import type { LucideComponent } from '~/types/lucide';

const iconMap = Icons as unknown as Record<string, LucideComponent>;

type Item = {
	title: string;
	icon: string;
	publishedAt: Date;
	href?: string;
};

export interface Props {
	class?: string;
	empty?: {
		title?: string;
		description?: string;
	};
	href?: string;
	id: string;
	items: Array<Item>;
	title: string;
}

const {
	class: className,
	empty,
	href,
	id,
	items,
	title,
} = Astro.props as Props;

const hasUrl = !!href;
const TitleComponent = hasUrl ? 'a' : 'h3';
const titleAnchorProps = hasUrl ? { href } : {};
---

<section
	class={cn(
		'overflow-auto rounded-xl border-2 border-gray-100 bg-white px-2 pb-2 dark:border-gray-900 dark:bg-gray-950',
		className,
	)}
	id={id}
>
	<TitleComponent
		class={cn(
			'absolute mx-4 inline-flex -translate-y-3 transform-gpu items-center rounded-full border-2 border-gray-100 bg-white px-4 text-sm font-bold text-gray-600 dark:border-gray-900 dark:bg-gray-950 dark:text-white',
			hasUrl ? 'default-transition default-focus' : '',
		)}
		{...titleAnchorProps}
	>
		{title}
	</TitleComponent>

	{items.length > 0 ? (
		<ul
			class="mt-3 flex flex-col space-y-2 divide-y-2 divide-gray-100 dark:space-y-0 dark:divide-y-0"
			role="list"
		>
			{items.map((item, index) => {
				const Icon = iconMap[item.icon]!;

				const itemHref = item.href;
				const hasItemUrl = typeof itemHref === 'string';
				const isExternal =
					hasItemUrl && /^https?:\/\//.test(itemHref);
				const Component = hasItemUrl ? 'a' : 'div';

				const itemAnchorProps = hasItemUrl
					? {
							href: itemHref,
							...(isExternal
								? {
										target: '_blank',
										rel: 'noopener noreferrer',
									}
								: {}),
						}
					: {};

				return (
					<li>
						<Component
							{...itemAnchorProps}
							class={cn(
								'flex items-center justify-between space-x-4 rounded-md border-2 border-white bg-white p-2.5 text-gray-400 default-transition default-focus hover:border-gray-100 hover:bg-gray-50 hover:text-gray-500 dark:border-gray-900 dark:bg-gray-950 dark:text-gray-300 dark:hover:border-gray-800 dark:hover:bg-gray-900 dark:hover:text-gray-200',
								{ 'mt-2': index > 0 },
							)}
						>
							<div class="flex min-w-0 items-center space-x-3 text-xs font-semibold">
								<Icon class="h-4 w-4 shrink-0" />

								<p
									class="min-w-0 whitespace-normal break-words leading-5"
									title={item.title}
								>
									{item.title}
								</p>
							</div>

							<time
								class="shrink-0 text-[13px] font-normal"
								datetime={item.publishedAt.toISOString()}
								title={formatLongDate(item.publishedAt)}
							>
								{formatShortDate(item.publishedAt)}
							</time>
						</Component>
					</li>
				);
			})}
		</ul>
	) : (
		<div class="flex h-full items-center justify-center">
			<div class="space-y-2 text-center">
				<Newspaper class="mx-auto" />

				<h3 class="text-base font-semibold text-gray-900 dark:text-gray-200">
					{empty?.title ?? 'No posts here yet'}
				</h3>

				<p class="text-sm text-gray-400 dark:text-gray-600">
					{empty?.description ?? 'Stay tuned for more content soon'}
				</p>
			</div>
		</div>
	)}
</section>