---
import { formatLongDate, formatShortDate } from '~/utils/date';
import * as Icons from 'lucide-astro';
import { FlagTriangleRight } from 'lucide-astro';

import { cn } from '~/utils/cn';

import type { CollectionEntry } from 'astro:content';

import type { LucideComponent } from '~/types/lucide';

const iconMap = Icons as unknown as Record<string, LucideComponent>;

type Event = CollectionEntry<'events'>;

export interface Props {
	class?: string;
	events: Array<Event['data']>;
	id: string;
	title: string;
}

const { class: className, events, id, title } = Astro.props;
---

<section
	class={cn(
		'overflow-auto rounded-xl border-2 border-gray-100 bg-white px-2 pb-2 dark:border-gray-900 dark:bg-gray-950',
		className,
	)}
	id={id}
>
	<h3 class="absolute z-30 mx-4 inline-flex -translate-y-3 transform-gpu items-center rounded-full border-2 border-gray-100 bg-white px-4 text-sm font-bold text-gray-600 dark:border-gray-900 dark:bg-gray-950 dark:text-white">
		{title}
	</h3>

	{events.length > 0 ? (
		<ul class="mt-6 flow-root" role="list">
			{events.map((event, index) => {
				const Icon = iconMap[event.icon]!;

				const hasUrl = !!event.url;
				const Component = hasUrl ? 'a' : 'div';

				const anchorProps = hasUrl
					? {
							href: event.url,
							target: '_blank',
							rel: 'noopener noreferrer',
						}
					: {};

				const showConnector = index + 1 !== events.length;

				return (
					<li class="group relative pb-3">
						{showConnector ? (
							<span
								aria-hidden={true}
								class="absolute left-6 top-4 z-0 -ml-px h-full w-0.5 bg-gray-100 dark:bg-gray-900"
							/>
						) : null}

						<Component
							class="default-focus default-transition relative flex space-x-3 rounded-md px-2"
							{...anchorProps}
						>
							<div
								class={cn(
									'default-transition z-20 flex h-8 w-8 items-center justify-center rounded-md border-2 border-gray-100 bg-white text-gray-400 ring-2 ring-white group-hover:text-gray-500 dark:border-gray-900 dark:bg-gray-950 dark:text-gray-300 dark:ring-gray-950 dark:group-hover:text-white',
									{
										'group-hover:border-gray-200 dark:group-hover:border-gray-800':
											hasUrl,
									},
								)}
							>
								<Icon class="h-4 w-4" />
							</div>

							<div
								class={cn(
									'default-transition flex min-w-0 flex-1 items-center gap-2 pt-1.5 text-gray-400 dark:text-gray-300',
									{
										'group-hover:text-gray-500 dark:group-hover:text-white':
											hasUrl,
									},
								)}
							>
								<p
									class="min-w-0 flex-1 truncate text-xs font-semibold"
									title={event.title}
								>
									{event.title}
								</p>

								<span class="inline-flex h-5 w-8 shrink-0 items-center justify-center rounded-sm border border-gray-200 text-[10px] font-bold leading-none tracking-wide dark:border-gray-800">
									{event.region}
								</span>

								<time
									class="w-[4.5rem] shrink-0 text-right text-[13px] font-normal tabular-nums md:text-xs"
									datetime={event.date.toISOString()}
									title={formatLongDate(event.date)}
								>
									{formatShortDate(event.date)}
								</time>
							</div>
						</Component>
					</li>
				);
			})}
		</ul>
	) : (
		<div class="flex h-full items-center justify-center">
			<div class="space-y-2 text-center">
				<FlagTriangleRight class="mx-auto" />

				<h3 class="text-base font-semibold text-gray-900 dark:text-gray-200">
					No shows announced yet
				</h3>

				<p class="text-sm text-gray-400 dark:text-gray-600">
					New dates coming soon
				</p>
			</div>
		</div>
	)}
</section>