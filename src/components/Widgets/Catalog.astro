---
import { Disc3 } from 'lucide-astro';

import { cn } from '~/utils/cn';

export interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<section
	class={cn(
		'relative overflow-auto rounded-xl border-2 border-gray-100 bg-white px-2 pb-2 dark:border-gray-900 dark:bg-gray-950',
		className,
	)}
	id="catalog"
>
	<h3 class="absolute -top-3 left-4 inline-flex rounded-full border-2 border-gray-100 bg-white px-4 text-sm font-bold text-gray-600 dark:border-gray-900 dark:bg-gray-950 dark:text-white">
		Catalog
	</h3>

	<div class="flex min-h-48 items-center justify-center px-4 pb-6 pt-8">
		<div class="space-y-2 text-center">
			<Disc3 class="mx-auto text-gray-400 dark:text-gray-500" />

			<h3 class="text-md font-semibold text-gray-900 dark:text-gray-200">
				No releases listed yet
			</h3>

			<p class="text-sm text-gray-400 dark:text-gray-600">
				Catalog coming soon
			</p>
		</div>
	</div>
</section>