---
export interface Props {
	number?: number;
}

const { number = 15 } = Astro.props;

const random = (seed: number): number => {
	const value = Math.sin(seed * 12.9898) * 43758.5453;

	return value - Math.floor(value);
};

const meteors = Array.from({ length: number }, (_, index) => ({
	animationDelay: `-${(random(index + 201) * 8).toFixed(2)}s`,
	animationDuration: `${(5 + random(index + 301) * 5).toFixed(2)}s`,
	hideOnMobile: index >= 16,
	isRgb: index % 12 === 5,
	left: `${Math.round(random(index + 101) * 110)}%`,
	top: `${Math.round(random(index + 1) * 100)}%`,
}));
---

<div
	aria-hidden="true"
	class="pointer-events-none fixed inset-0 z-0 overflow-hidden motion-reduce:hidden"
	data-meteor-field
>
	{meteors.map((meteor) => (
		<span
			class:list={[
				'meteor absolute h-0.5 w-0.5 rounded-full opacity-0 shadow-[0_0_0_1px_#ffffff10] will-change-transform',
				'before:absolute before:top-1/2 before:h-0.5 before:w-[3.46875rem] before:-translate-y-1/2 before:rounded-full before:content-[""]',
				meteor.isRgb
					? 'meteor-rgb'
					: 'meteor-white bg-gray-100 before:bg-gradient-to-r before:from-gray-300 before:to-transparent dark:bg-gray-600 dark:before:from-gray-600',
				meteor.hideOnMobile && 'hidden sm:block',
			]}
			data-meteor
			style={`top: ${meteor.top}; left: ${meteor.left}; animation-delay: ${meteor.animationDelay}; animation-duration: ${meteor.animationDuration};`}
		/>
	))}
</div>

<style>
	.meteor {
		animation-iteration-count: infinite;
		animation-timing-function: linear;
	}

	.meteor-white {
		animation-name: meteor-white-motion;
	}

	.meteor-rgb {
		animation-name: meteor-rgb-motion;
		background-color: #60a5fa;
	}

	.meteor-rgb::before {
		background-image: linear-gradient(
			to right,
			#ef4444 0%,
			#22c55e 38%,
			#3b82f6 72%,
			transparent 100%
		);
	}

	@keyframes meteor-white-motion {
		0% {
			opacity: 0;
			transform: rotate(215deg) translateX(0);
		}

		8% {
			opacity: 1;
		}

		68% {
			opacity: 1;
		}

		84% {
			opacity: 0;
		}

		100% {
			opacity: 0;
			transform: rotate(215deg) translateX(-500px);
		}
	}

	@keyframes meteor-rgb-motion {
		0% {
			opacity: 0;
			transform: rotate(215deg) translateX(0);
		}

		4% {
			opacity: 0.2;
		}

		8% {
			opacity: 0.65;
		}

		84% {
			opacity: 0.65;
		}

		88% {
			opacity: 0.2;
		}

		92% {
			opacity: 0;
		}

		100% {
			opacity: 0;
			transform: rotate(215deg) translateX(-500px);
		}
	}
</style>

<script>
	const initializeMeteorRespawning = () => {
		const meteorField = document.querySelector<HTMLElement>(
			'[data-meteor-field]',
		);

		if (
			meteorField === null ||
			meteorField.dataset.respawnInitialized === 'true'
		) {
			return;
		}

		meteorField.dataset.respawnInitialized = 'true';

		meteorField.addEventListener('animationiteration', (event) => {
			const meteor = event.target;

			if (
				!(meteor instanceof HTMLElement) ||
				!meteor.matches('[data-meteor]')
			) {
				return;
			}

			const isMobile = window.matchMedia('(max-width: 639px)').matches;
			const favorUpperViewport = isMobile && Math.random() < 0.6;

			const top = favorUpperViewport
				? 3 + Math.random() * 42
				: Math.random() * 100;

			const left = -5 + Math.random() * 115;

			meteor.style.top = `${top.toFixed(1)}%`;
			meteor.style.left = `${left.toFixed(1)}%`;
		});
	};

	initializeMeteorRespawning();

	document.addEventListener('astro:page-load', initializeMeteorRespawning);
</script>