---
import { Image } from 'astro:assets';
import { ExternalLink } from 'lucide-astro';

import cover from '~/assets/releases/sprites-tamaranch-cover.jpg';
---

<section
	class="relative z-10 rounded-xl border-2 border-gray-100 bg-white px-4 pb-5 dark:border-gray-900 dark:bg-gray-950"
	id="featured-release"
>
	<h3 class="absolute -top-3 left-4 inline-flex rounded-full border-2 border-gray-100 bg-white px-4 text-sm font-bold text-gray-600 dark:border-gray-900 dark:bg-gray-950 dark:text-white">
		Featured Release
	</h3>

	<div class="release-viewport relative -mx-4 overflow-hidden px-4">
		<div class="release-layout mx-auto grid max-w-3xl pt-8">
			<details class="release">
				<summary
					aria-label="Reveal links for Armoured Carapace"
					class="release-toggle cursor-pointer rounded-lg"
				>
					<div class="release-art mx-auto w-full max-w-xs rounded-xl px-10 py-3">
						<div class="relative aspect-square">
							<span aria-hidden="true" class="release-vinyl"></span>

							<Image
								alt="Armoured Carapace cover artwork"
								class="release-cover absolute inset-0 z-10 h-full w-full rounded-lg object-cover shadow-lg"
								decoding="async"
								loading="eager"
								src={cover}
							/>
						</div>
					</div>
				</summary>
			</details>

			<div class="release-links">
				<a
					class="release-link default-transition inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md border-2 bg-white px-3 py-2 text-sm font-bold text-gray-500 hover:bg-gray-50 hover:text-gray-600 dark:bg-gray-950 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white"
					href="https://spritesbass.bandcamp.com/"
					rel="noopener noreferrer"
					target="_blank"
				>
					<span>Bandcamp</span>
					<ExternalLink aria-hidden="true" class="h-4 w-4" />
				</a>

				<a
					class="release-link default-transition inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md border-2 bg-white px-3 py-2 text-sm font-bold text-gray-500 hover:bg-gray-50 hover:text-gray-600 dark:bg-gray-950 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white"
					href="https://soundcloud.com/spritesbass"
					rel="noopener noreferrer"
					target="_blank"
				>
					<span>SoundCloud</span>
					<ExternalLink aria-hidden="true" class="h-4 w-4" />
				</a>
			</div>

			<div class="release-meta space-y-1 text-center">
				<h2
					class="text-[22px] font-bold text-black sm:text-2xl dark:text-white"
					style="font-family: 'Space Mono', monospace;"
				>
					Armoured Carapace
				</h2>

				<p class="text-[13px] font-medium text-gray-400 dark:text-gray-400">
					Fall 2026
				</p>

				<p class="text-xs text-gray-400 dark:text-gray-500">
					(Open cover for release links)
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.release-layout {
		--release-magenta: rgb(123 26 130);
		--release-magenta-hover: rgb(112 26 117);

		grid-template-areas:
			'release'
			'links'
			'meta';
	}

	.release {
		grid-area: release;
		min-width: 0;
	}

	.release-meta {
		grid-area: meta;
		margin-top: 1rem;
	}

	.release-toggle {
		list-style: none;
		-webkit-tap-highlight-color: transparent;
	}

	.release-toggle::-webkit-details-marker {
		display: none;
	}

	.release-toggle:focus {
		outline: none;
	}

	.release-toggle:focus-visible .release-art,
	.release[open] .release-art {
		box-shadow: inset 0 0 0 2px var(--release-magenta);
	}

	.release-art {
		transition: box-shadow 250ms ease;
	}

	.release-link {
		border-color: var(--release-magenta);
	}

	.release-link:hover {
		border-color: var(--release-magenta-hover);
	}

	.release-link:focus {
		outline: none;
	}

	.release-link:focus-visible {
		box-shadow: inset 0 0 0 2px var(--release-magenta-hover);
	}

	.release-cover,
	.release-vinyl {
		transition:
			transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.release-vinyl {
		position: absolute;
		inset: 4%;
		border-radius: 9999px;
		background: repeating-radial-gradient(
			circle at center,
			#111 0,
			#111 3px,
			#222 4px,
			#111 6px
		);
		box-shadow: 0 12px 30px rgb(0 0 0 / 20%);
		transform: translateX(0) rotate(0deg);
	}

	.release-vinyl::after {
		position: absolute;
		inset: 38%;
		border: 3px solid #e5e7eb;
		border-radius: 9999px;
		background: #f9fafb;
		content: '';
	}

	.release[open] .release-cover {
		box-shadow: 0 18px 40px rgb(0 0 0 / 25%);
		transform: translateX(-8%);
	}

	.release[open] .release-vinyl {
		transform: translateX(16%) rotate(90deg);
	}

	.release-links {
		grid-area: links;
		display: flex;
		max-height: 0;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0;
		overflow: hidden;
		opacity: 0;
		pointer-events: none;
		visibility: hidden;
		transform: translateY(-0.75rem);
		transition:
			max-height 350ms ease,
			margin-top 350ms ease,
			opacity 250ms ease,
			transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.release[open] + .release-links {
		max-height: 4.5rem;
		margin-top: 0.75rem;
		overflow: visible;
		opacity: 1;
		pointer-events: auto;
		visibility: visible;
		transform: translateY(0);
	}

	@media (min-width: 768px) {
		.release-layout {
			grid-template-areas:
				'. release links'
				'meta meta meta';
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			align-items: center;
		}

		.release-art {
			width: 21rem;
			max-width: 21rem;
			padding-inline: 3rem;
		}

		.release-links {
			width: 9rem;
			max-width: none;
			max-height: 12rem;
			align-self: center;
			justify-self: start;
			flex-direction: column;
			margin: 0 0 0 0.5rem;
			overflow: visible;
			opacity: 0;
			visibility: hidden;
			transform: translateX(0.75rem);
			transition:
				opacity 180ms ease,
				transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
				visibility 0s linear 260ms;
		}

		.release[open] + .release-links {
			max-width: none;
			max-height: 12rem;
			margin: 0 0 0 0.5rem;
			overflow: visible;
			opacity: 1;
			visibility: visible;
			transform: translateX(0);
			transition:
				opacity 180ms ease,
				transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
				visibility 0s linear 0s;
		}

		.release-link {
			width: 100%;
		}

		.release[open] .release-cover {
			transform: translateX(-8%);
		}

		.release[open] .release-vinyl {
			transform: translateX(18%) rotate(90deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.release-art,
		.release-cover,
		.release-vinyl,
		.release-links {
			transition-duration: 0.01ms;
		}
	}
</style>
