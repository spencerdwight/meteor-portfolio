---
import Avatar from '~/components/Avatar.astro';
import { HOME } from '~/constants';
---

<section
	class="z-10 space-y-4 sm:flex sm:gap-8 sm:space-y-0"
	id="hero"
>
	<div class="max-w-3xl flex-grow space-y-4 pl-2 font-semibold not-italic leading-9 tracking-tighter">
		<h1 class="text-3xl tracking-[0.419em] text-black dark:text-white">
			{HOME.title}
		</h1>

		<h2 class="text-xl text-gray-400 dark:text-gray-600 md:max-w-md">
			{HOME.subtitle}
		</h2>
	</div>

	<div class="hidden sm:block">
		<Avatar
			className="h-24 w-24 lg:h-32 lg:w-32"
			height={128}
			width={128}
		/>
	</div>
</section>